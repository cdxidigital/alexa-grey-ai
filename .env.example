# Alexa Grey AI Studio: example values only. Never commit actual credentials or identity documents.
# Web app authentication (required by the existing project)
BETTER_AUTH_SECRET=
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# Restricted creator access. Example: alexa@example.com,manager@example.com
ALEXA_STUDIO_ALLOWED_EMAILS=

# ID/reference of an actual signed creator consent record held outside this repo.
# DO NOT invent the consent record or set flags until creator identity and adulthood are verified.
ALEXA_LIKENESS_CONSENT_RECORD_ID=
ALEXA_CREATOR_ADULT_VERIFIED=false

# Secure signing key, at least 24 characters. Never expose client-side.
STUDIO_SIGNING_SECRET=

# Provider key, server only; generation stays disabled if not configured.
FAL_KEY=

# Optional: comma-separated URLs for CREATOR-APPROVED original reference portraits.
# Required for natural-language Eve photo tool; browser Studio instead accepts local uploads.
# Fal must be able to retrieve these URLs. Never commit them into source.
ALEXA_APPROVED_REFERENCE_URLS=
